############################################
# darkroom: calibrate, register, stack (Siril 1.4)
# OSC lights; master dark, bias and flat each optional
# Rendered by `darkroom stack`; the double-brace placeholders are replaced with
# absolute, quoted paths (siril-cli starts in ~/Pictures) and the [stack]
# settings. Template syntax (conditional lines, defaults): see darkroom/siril.py.
############################################
requires 1.4.0
setext fit
set16bits

# 1. Link the raw lights into a sequence. SUBS is <work>/process/subs: darkroom
#    puts one link there per selected sub (.fit, .fits or .fts; JPGs and files
#    that do not match the camera's sub_glob left out), so Siril stacks exactly
#    those and never works inside the user's folder
cd "{{SUBS}}"
link light "-out={{PROCESS}}"

# 2. Calibrate: subtract the master dark (or, without one, the master bias), divide
#    by the master flat, fix hot/cold pixels from the dark, debayer. Only one of
#    these lines is kept; without any calibration frame it debayers only.
#    The masters come from <work>/masters or [target] dark/bias/flats.
cd "{{PROCESS}}"
{{if DARK}}{{if FLAT}}calibrate light "-dark={{DARK}}" "-flat={{FLAT=}}" -cc=dark 3 3 -cfa -equalize_cfa -debayer
{{if DARK}}{{ifnot FLAT}}calibrate light "-dark={{DARK}}" -cc=dark 3 3 -cfa -equalize_cfa -debayer
{{ifnot DARK}}{{if BIAS}}{{if FLAT}}calibrate light "-bias={{BIAS=}}" "-flat={{FLAT=}}" -cfa -equalize_cfa -debayer
{{ifnot DARK}}{{if BIAS}}{{ifnot FLAT}}calibrate light "-bias={{BIAS=}}" -cfa -equalize_cfa -debayer
{{ifnot DARK}}{{ifnot BIAS}}{{if FLAT}}calibrate light "-flat={{FLAT=}}" -cfa -equalize_cfa -debayer
{{ifnot DARK}}{{ifnot BIAS}}{{ifnot FLAT}}calibrate light -cfa -equalize_cfa -debayer

# 3. Register: pick best reference, compute transforms (homography)
register pp_light -2pass -maxstars=1000

# 4. Apply transforms, keep the best frames by weighted FWHM and roundness
#    (default 90% each) and optionally by background level and star count
#    (keep_bkg / keep_stars, off by default), frame the output (default min:
#    the area common to all frames)
seqapplyreg pp_light -filter-wfwhm={{KEEP_FWHM=90}}% -filter-round={{KEEP_ROUND=90}}% {{MORE_FILTERS=}}-framing={{FRAMING=min}}

# 5. Stack: winsorized sigma rejection, add+scale normalization, weight by wFWHM
#    (-maximize is needed to stack a -framing=max sequence)
{{ifnot MAXIMIZE}}stack r_pp_light rej w 3 3 -norm=addscale -output_norm -weight=wfwhm -32b "-out={{STACK}}"
{{if MAXIMIZE}}stack r_pp_light rej w 3 3 -norm=addscale -output_norm -weight=wfwhm -maximize -32b "-out={{STACK}}"

close
