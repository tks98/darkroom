############################################
# darkroom: re-frame and re-stack an already calibrated and registered
# sequence (`darkroom stack --reuse-registration`). Same steps 4 and 5 as
# stack.ssf; the registration data comes from pp_light_.seq in the process dir.
############################################
requires 1.4.0
setext fit
set16bits

cd "{{PROCESS}}"
seqapplyreg pp_light -filter-wfwhm={{KEEP_FWHM=90}}% -filter-round={{KEEP_ROUND=90}}% -framing={{FRAMING=min}}
{{ifnot MAXIMIZE}}stack r_pp_light rej w 3 3 -norm=addscale -output_norm -weight=wfwhm -32b "-out={{STACK}}"
{{if MAXIMIZE}}stack r_pp_light rej w 3 3 -norm=addscale -output_norm -weight=wfwhm -maximize -32b "-out={{STACK}}"

close
