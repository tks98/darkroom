############################################
# darkroom: plate solve + spectrophotometric color calibration
# Input: GraXpert background-extracted stack (linear), bge.fits
# Rendered by `darkroom color`.
############################################
requires 1.4.0
setext fit
cd "{{WORK}}"
load bge.fits
platesolve -focal={{FOCAL}} -pixelsize={{PIXEL}} -catalog={{CATALOG}}
# [color] narrowband: SPCC's narrowband mode (filter wavelengths and bandwidths)
# instead of a filter curve from Siril's database
{{ifnot NARROWBAND}}spcc "-oscsensor={{SENSOR}}" "-oscfilter={{FILTER}}" "-whiteref={{WHITEREF=Average Spiral Galaxy}}"
{{if NARROWBAND}}spcc "-oscsensor={{SENSOR}}" -narrowband {{NARROWBAND=}} "-whiteref={{WHITEREF=Average Spiral Galaxy}}"
save spcc
